---
import { getSiteOffer } from '../../../../supabase/functions/_shared/site-offer';
const offer = getSiteOffer();
---
<section id="planos" class="section-pricing section-wrap">
  <h2>Uma contratação. Uma entrega. Sem mensalidade.</h2>
  <div class="pricing-grid">
    <article class="pricing-card campaign">
      <p data-promo hidden={!offer.active}>Black Friday • só até 30/11</p>
      <h3>Site Novo</h3>
      <p data-promo hidden={!offer.active}>De <s>R$ 1.497</s> por</p>
      <strong data-site-price>{offer.setupPrice}</strong>
      <p>Pagamento único pela criação da página.</p>
      <p data-promo hidden={!offer.active}>Economize R$ 1.000. Até 30/11/2026, às 23h59 (Brasília).</p>
      <a href="/signup?plan=site_novo" class="btn btn-primary">Quero minha página</a>
    </article>
    <article class="pricing-card">
      <h3>Perfil Google</h3><strong>R$ 297</strong>
      <p>Criação e configuração do Perfil da Empresa no Google. Pagamento único.</p>
      <p>A verificação e aprovação dependem do Google.</p>
      <a href="/signup?plan=gbp_avulso" class="btn btn-outline">Contratar Perfil Google</a>
    </article>
    <article class="pricing-card">
      <h3>Site + Perfil Google</h3><strong>R$ 750</strong>
      <p>Criação da página e do Perfil Google. As duas entregas, sem assinatura.</p>
      <a href="/signup?plan=site_gbp" class="btn btn-outline">Contratar os dois</a>
    </article>
  </div>
</section>
<script>
  import { getSiteOffer } from '../../../../supabase/functions/_shared/site-offer';
  function updateOffer() {
    const offer = getSiteOffer();
    document.querySelectorAll('[data-site-price]').forEach(el => el.textContent = offer.setupPrice);
    document.querySelectorAll<HTMLElement>('[data-promo]').forEach(el => el.hidden = !offer.active);
  }
  updateOffer();
  window.setInterval(updateOffer, 1000);
</script>
<style>
.section-pricing { padding-block:5rem; }
h2 { text-align:center; font-size:clamp(1.8rem,4vw,2.7rem); margin-bottom:2rem; }
.pricing-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1.25rem; }
.pricing-card { border:1px solid var(--brand-border); border-radius:.75rem; padding:1.75rem; display:flex; flex-direction:column; gap:1rem; }
.pricing-card h3 { font-size:1.5rem; }
.pricing-card strong { font-size:2.8rem; }
.pricing-card p { color:var(--brand-ink-muted); }
.campaign { border-color:var(--campaign-red); }
.campaign strong,.campaign [data-promo] { color:var(--campaign-red); }
.pricing-card a { margin-top:auto; justify-content:center; }
@media(max-width:800px) { .pricing-grid { grid-template-columns:1fr; } }
</style>
